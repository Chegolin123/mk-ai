# syntax=docker/dockerfile:1
# GPU-образ: CUDA 12.4 + torch cu124. Требует nvidia-container-toolkit на хосте.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SDL_VIDEODRIVER=dummy \
    SDL_AUDIODRIVER=dummy

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3.11 python3-pip libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
 && ln -sf /usr/bin/pip3 /usr/local/bin/pip

WORKDIR /app

COPY requirements.txt .
RUN pip install torch --index-url https://download.pytorch.org/whl/cu124 \
 && pip install pygame numpy pillow

COPY game.py ./
COPY models ./models
COPY tools ./tools
COPY docs ./docs
COPY README.md LICENSE ./

RUN mkdir -p runs
VOLUME ["/app/models", "/app/runs"]

ENTRYPOINT ["python", "game.py"]
CMD ["--headless", "--episodes", "500"]
